# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

aws_region = "us-east-1"

# GitHub connection for Amplify
github_repository_url = "https://github.com/landsamboni/pedidoscloud"
github_access_token   = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
amplify_branch        = "main"

# Database
db_instance_class      = "db.t3.small"
db_password            = "change-me-strong-password"
# MUST include 0.0.0.0/0: Amplify WEB_COMPUTE SSR is not in a VPC, so it reaches
# RDS over the public endpoint. Add your laptop /32 for migrations. Protected by
# a strong password + TLS (rds.force_ssl). See README → Escalabilidad/Seguridad.
db_allowed_cidr_blocks = ["203.0.113.10/32", "0.0.0.0/0"]
# Prisma pool size per SSR Lambda instance (db.t3.small allows ~225 connections).
db_connection_limit    = 10

# App auth — admin logs in at /login with this password.
# Restaurants log in with a bcrypt password stored in the DB (set from /admin),
# NOT here. The old RESTAURANT_USER/PASSWORD vars were removed.
admin_password = "change-me-admin"

# JWT session secret — REQUIRED (app throws in prod without it).
# Generate with: openssl rand -base64 32
auth_secret = "change-me-generate-with-openssl-rand-base64-32"

# Optional admin MFA (TOTP / authenticator app). Empty = disabled.
# admin_totp_secret = "BASE32SECRET..."

# Monitoring — email for CloudWatch alarms + AWS Budgets cost alerts.
# Empty = alarms visible in console only, no budget created.
alert_email        = "tu-email@ejemplo.com"
monthly_budget_usd = 150

# Optional
enable_secrets_manager = false
