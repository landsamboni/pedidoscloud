# =====================================================================
# PedidosCloud — apps/web environment variables
# Copy to .env for local development. In staging/prod these are set as
# Amplify branch-level environment variables (via Terraform).
# NEVER commit .env — it is gitignored.
# =====================================================================

# ---- Database -------------------------------------------------------
# Local (Docker Compose Postgres — run `docker compose up -d` from repo root):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_orders?schema=public"

# Cloud (Amazon RDS) — Terraform outputs this with sslmode=require:
# DATABASE_URL="postgresql://USER:PASSWORD@host.us-east-1.rds.amazonaws.com:5432/pedidoscloud?schema=public&sslmode=require"

# ---- File storage ---------------------------------------------------
# "local" writes to apps/web/public/uploads (default for local dev, no AWS needed).
# "s3" uploads to a private S3 bucket; files are served via the /api/files proxy.
STORAGE_DRIVER="local"

# Required when STORAGE_DRIVER="s3".
# Note: AWS Amplify forbids env var names starting with "AWS", so credentials
# use S3_-prefixed names. Terraform sets these automatically in the branch.
# S3_REGION="us-east-1"
# S3_BUCKET="pedidoscloud-staging-uploads"
# S3_ACCESS_KEY_ID="..."       # from Terraform `iam` module output
# S3_SECRET_ACCESS_KEY="..."

# ---- Session auth (JWT signing key) ---------------------------------
# Generate with: openssl rand -base64 32
# In staging/prod: set as Amplify branch-level env var via Terraform.
AUTH_SECRET=""

# ---- Operator auth (login at /login, JWT session — see lib/auth.ts) -
# Admins log in with these credentials. If ADMIN_PASSWORD is empty, admin
# login is disabled (set it in staging/prod). Restaurants do NOT use env
# vars: each one logs in with its own bcrypt password stored in the DB
# (set from the /admin UI), using its slug as the username.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# ---- Per-restaurant WhatsApp ----------------------------------------
# whatsappPhone is stored in the Restaurant model (set via /admin UI).
# The /r/{slug}/orders/{token} page uses it for the "Preguntar por WhatsApp"
# button when the customer is waiting for payment confirmation.
# No env var needed — configured per restaurant in the database.
