# =====================================================================
# PedidosCloud — apps/web environment variables
# Copy to .env for local development. In staging/prod these are set as
# Amplify environment variables (see DEPLOYMENT.md), never committed.
# =====================================================================

# ---- Database -------------------------------------------------------
# Local (Docker Compose Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_orders?schema=public"
# Cloud (Amazon RDS) example — require SSL:
# DATABASE_URL="postgresql://USER:PASSWORD@your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/pedidoscloud?schema=public&sslmode=require"

# ---- File storage ---------------------------------------------------
# "local" writes to apps/web/public/uploads (default, for local dev).
# "s3" uploads to a private S3 bucket and serves via the /api/files proxy.
STORAGE_DRIVER="local"

# Required when STORAGE_DRIVER="s3". Note: AWS Amplify forbids env var names
# starting with "AWS", so credentials use S3_-prefixed names here. If the keys
# are omitted, the AWS SDK default provider chain is used (e.g. an IAM role).
# S3_REGION="us-east-1"
# S3_BUCKET="pedidoscloud-uploads-staging"
# S3_ACCESS_KEY_ID="..."          # from the Terraform `iam` module output
# S3_SECRET_ACCESS_KEY="..."

# ---- Operator auth (HTTP Basic Auth, see middleware.ts) -------------
# If a password is empty/unset, that area is left OPEN (dev convenience).
# Always set strong passwords in staging/prod.
ADMIN_USER="admin"
ADMIN_PASSWORD=""
RESTAURANT_USER="restaurante"
RESTAURANT_PASSWORD=""
