generator client {
  provider      = "prisma-client-js"
  // "native" covers the CodeBuild build machine.
  // "rhel-openssl-3.0.x" covers Amplify's SSR compute (Amazon Linux 2023 / Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  PAYMENT_PENDING
  PAYMENT_REVIEW
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  CANCELLED
}

model Restaurant {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  basePrice     Decimal             @db.Decimal(12, 2)
  nequiAccountName String?
  nequiPhone       String?
  nequiQrPath      String?
  whatsappPhone    String?
  passwordHash     String?           // bcrypt hash — set by admin, changeable by restaurant
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  menus         Menu[]
  customers     Customer[]
  orders        Order[]
  dailyCounters DailyOrderCounter[]
  paymentMethods PaymentMethod[]
}

model PaymentMethod {
  id           String     @id @default(cuid())
  restaurantId String
  label        String     // e.g. "Daviplata", "Nequi secundario", "Bancolombia"
  phone        String     // number or key to display and copy
  accountName  String     // account holder name
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Menu {
  id           String     @id @default(cuid())
  restaurantId String
  date         DateTime   @db.Date
  soups        String[]
  proteins     String[]
  sides        String[]
  drinks       String[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
}

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  lastAddress  String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([restaurantId, phone])
}

model Order {
  id           String      @id @default(cuid())
  publicToken  String      @unique @default(uuid())
  restaurantId String
  customerId   String
  orderDate    String
  orderNumber  Int
  status       OrderStatus @default(NEW)
  total        Decimal     @db.Decimal(12, 2)
  address      String
  paymentProofPath String?
  paymentSubmittedAt DateTime?
  createdAt    DateTime    @default(now())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        OrderItem[]

  @@unique([restaurantId, orderDate, orderNumber])
  @@index([restaurantId, orderDate, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  soup      String
  protein   String
  side      String
  drink     String
  price     Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DailyOrderCounter {
  id           String     @id @default(cuid())
  restaurantId String
  date         String
  lastNumber   Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
}
