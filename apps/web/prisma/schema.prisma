generator client {
  provider      = "prisma-client-js"
  // "native" covers the CodeBuild build machine.
  // "rhel-openssl-3.0.x" covers Amplify's SSR compute (Amazon Linux 2023 / Lambda).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  PAYMENT_PENDING
  PAYMENT_REVIEW
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  CANCELLED
}

model Restaurant {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  basePrice     Decimal             @db.Decimal(12, 2)
  // "combo" = fixed categories (soups/proteins/sides/drinks), original behavior.
  // "catalog" = dynamic categories with per-item prices and free quantities.
  menuType      String              @default("combo")
  // Display label for a single order unit shown to the customer (e.g. "almuerzo",
  // "pedido", "caja"). Used in totals and confirmations.
  orderUnitLabel String             @default("almuerzo")
  nequiAccountName String?
  nequiPhone       String?
  nequiQrPath      String?
  menuTemplatePath String?           // currently selected background for the shareable menu PNG
  menuTemplateHistory String[] @default([]) // last 4 uploaded templates (most recent first)
  logoPath         String?           // restaurant logo (customer page header + menu image)
  deliveryMode     String   @default("separate") // "free" | "fixed" | "separate"
  deliveryFee      Decimal? @db.Decimal(12, 2)   // used when deliveryMode = "fixed"
  deliveryNote     String?           // optional note shown to the customer about delivery
  allowPickup      Boolean  @default(true) // offer "Recoger en restaurante" (no fee)
  whatsappPhone    String?
  passwordHash     String?           // bcrypt hash — set by admin, changeable by restaurant
  subscriptionStartedAt DateTime?   // date admin confirmed payment
  subscriptionEndsAt    DateTime?   // startedAt + 30 days (or extended)
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  menus         Menu[]
  customers     Customer[]
  orders        Order[]
  dailyCounters DailyOrderCounter[]
  paymentMethods PaymentMethod[]
}

model PaymentMethod {
  id           String     @id @default(cuid())
  restaurantId String
  label        String     // e.g. "Daviplata", "Nequi secundario", "Bancolombia"
  phone        String     // number / key / account number to display and copy
  accountName  String     // account holder name
  qrPath       String?    // optional QR image (like Nequi)
  accountType  String?    // "ahorros" | "corriente" — only for bank accounts
  idNumber     String?    // cédula — only for bank accounts
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// "combo" mode menu — original fixed categories (soups/proteins/sides/drinks).
// Kept for backward compatibility with existing restaurants.
model Menu {
  id           String         @id @default(cuid())
  restaurantId String
  date         DateTime       @db.Date
  soups        String[]
  proteins     String[]
  sides        String[]
  drinks       String[]
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // "catalog" mode: dynamic categories attached to this daily menu.
  categories   MenuCategory[]

  @@unique([restaurantId, date])
}

// "catalog" mode — dynamic categories with custom names and per-item prices.
model MenuCategory {
  id       String     @id @default(cuid())
  menuId   String
  name     String     // e.g. "Pasteles", "Rolls", "Bebidas"
  position Int        @default(0)
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@index([menuId])
}

model MenuItem {
  id         String       @id @default(cuid())
  categoryId String
  name       String       // e.g. "Pastel de chocolate"
  price      Decimal      @db.Decimal(12, 2)
  position   Int          @default(0)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  lastAddress  String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([restaurantId, phone])
}

model Order {
  id           String      @id @default(cuid())
  publicToken  String      @unique @default(uuid())
  restaurantId String
  customerId   String
  orderDate    String
  orderNumber  Int
  status       OrderStatus @default(NEW)
  total        Decimal     @db.Decimal(12, 2)
  deliveryFee  Decimal     @default(0) @db.Decimal(12, 2)
  fulfillment  String      @default("delivery") // "delivery" | "pickup"
  address      String
  customerName String
  paymentProofPath String?
  paymentSubmittedAt DateTime?
  createdAt    DateTime    @default(now())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        OrderItem[]

  @@unique([restaurantId, orderDate, orderNumber])
  @@index([restaurantId, orderDate, createdAt])
}

// Unified order item — supports both combo and catalog modes.
// combo: soup/protein/side/drink filled, catalogCategory/catalogItem/quantity unused.
// catalog: catalogCategory/catalogItem/quantity/unitPrice filled, soup-drink empty.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  // combo mode (legacy, kept for backward compat)
  soup      String  @default("")
  protein   String  @default("")
  side      String  @default("")
  drink     String  @default("")
  price     Decimal @default(0) @db.Decimal(12, 2)  // total price for combo row
  // catalog mode
  catalogCategory String  @default("") // category name snapshot
  catalogItem     String  @default("") // item name snapshot
  quantity        Int     @default(1)
  unitPrice       Decimal @default(0) @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DailyOrderCounter {
  id           String     @id @default(cuid())
  restaurantId String
  date         String
  lastNumber   Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
}
